{
  "name": "generatorlog",
  "version": "1.0.0",
  "private": true,
  "description": "GeneratorLog - Home power generator usage tracking",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm -r build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "test": "pnpm --filter generatorlog-backend test",
    "test:watch": "pnpm --filter generatorlog-backend test:watch",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "test:e2e:ui": "pnpm --filter frontend test:e2e:ui",
    "version:sync": "node scripts/sync-versions.js",
    "version:patch": "npm version patch && pnpm version:sync",
    "version:minor": "npm version minor && pnpm version:sync",
    "version:major": "npm version major && pnpm version:sync",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "install:all": "pnpm install"
  },
  "keywords": ["generator", "tracking", "monitoring"],
  "author": "Ray Pabonnie",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "pnpm": {
    "overrides": {
      "find-my-way@<9.7.0": ">=9.7.0",
      "fast-uri@<3.1.4": ">=3.1.4",
      "shell-quote@<1.9.0": ">=1.9.0",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "postcss@<8.5.18": ">=8.5.18",
      "@babel/core@<7.29.6": ">=7.29.6",
      "esbuild@<0.28.1": ">=0.28.1"
    }
  }
}
